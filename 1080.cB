/* --------------------------------------------------------------------------
Disciplina  : Lógica de Programação, turma IB, 2026S1
Nome        : Mariana Sales de Affini
Linguagem   : C
Problema    : https://judge.beecrowd.com/pt/problems/view/1080
Data        : 16/062026
Objetivo    : Saber qual o último valor lido e em que posição ele apareceu. 
Aprendizado : Estrutura de repetição e comparação de valores. 
Pergunta de segunda ordem: 
-------------------------------------------------------------------------- */
#include <stdio.h>

int main() {

    int numeros[100];
    int maior, posicao;

    for (int i = 0; i < 100; i++) {
        scanf("%d", &numeros[i]);
    }

    maior = numeros[0];
    posicao = 1;

    for (int i = 1; i < 100; i++) {
        if (numeros[i] > maior) {
            maior = numeros[i];
            posicao = i + 1;
        }
    }

    printf("%d\n", maior);
    printf("%d\n", posicao);

    return 0;
}
